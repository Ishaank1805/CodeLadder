#!/bin/sh
# BigCodeBench sandbox: killall NAME... limited to the test's own session (BCB_SID).
sig=""
status=1
for a in "$@"; do
  case "$a" in
    -s|--signal) sig="next" ;;
    -*) [ "$sig" = "next" ] && sig="$a"; : ;;
    *) if [ "$sig" = "next" ]; then sig="-$a"; else /usr/bin/pkill ${sig:+$sig} -s "${BCB_SID:?}" -x "$a" && status=0; fi ;;
  esac
done
exit $status
